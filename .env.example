# Set this locally or in the deployment platform's secret manager. Never commit .env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
# Astra requires low or higher; Sol/Terra also support none. Benchmark before switching.
OPENAI_REASONING_EFFORT=low
OPENAI_TIMEOUT_SECONDS=20
OPENAI_MAX_OUTPUT_TOKENS=2048
REQUEST_TIMEOUT_SECONDS=28
SOLVER_TIMEOUT_SECONDS=3
MAX_CONCURRENT_REQUESTS=8
# Normal operation: 128. Uncached HTTP benchmark: 0, then restart the server.
INTERPRETATION_CACHE_SIZE=128
# Service launcher only; Docker also honors PORT.
PORT=8000
